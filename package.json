{
  "name": "ticket-managment-path-app",
  "version": "1.0.0",
  "private": true,
  "description": "Painel privado de tickets do Duka — lê o schema `support` do Supabase",
  "scripts": {
    "dev": "next dev -p 3100",
    "voice": "powershell -NoProfile -ExecutionPolicy Bypass -File jarvis-voice\\start.ps1",
    "jarvis": "start \"JARVIS Voice\" powershell -NoExit -NoProfile -ExecutionPolicy Bypass -File jarvis-voice\\start.ps1 && next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "whatsapp": "cd ../duka_whas_bot && npm start",
    "contatos": "python scripts/sync_contatos_whatsapp.py",
    "powerbi": "python scripts/export_powerbi.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
